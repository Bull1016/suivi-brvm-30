# GEMINI_API_KEY: Required for Gemini AI API calls (descriptions + analyse BOC).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Gemini model used by the app
GEMINI_MODEL="gemini-3.6-flash"

# Optional local Express port
PORT=3000

# Local access by default; explicitly set HOST=0.0.0.0 for container/VM access.
HOST="127.0.0.1"

# Disabled by default. Enable only behind a trusted proxy that sanitizes
# X-Forwarded-For, with direct access to Express blocked.
# Set the exact trusted hop count (e.g. 1) and REVERSE_PROXY=true only then.
TRUST_PROXY=0

# Link to the BRVM 30 index composition PDF
BRVM_30_URL="https://www.sikafinance.com/docs/brvm-30-composition-de-l-indice-brvm-30.pdf"

# Official BRVM composition PDF monitored by the app for updates.
BRVM_30_AVIS_URL="https://www.brvm.org/sites/default/files/avis-191-2026.pdf"

# Delay (seconds) between two composition analysis attempts for the same
# BRVM_30_AVIS_URL after a failure or an unchanged avis. Default: 3600.
COMPOSITION_RETRY_DELAY_SECONDS=3600

# Explicit confirmation of the trusted proxy requirements above.
# Without true, Express proxy trust stays disabled even if TRUST_PROXY is positive.
REVERSE_PROXY="false"

# Upstash Redis (Vercel KV). Without these, local Express keeps state in memory only.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# Alternative names if you use the Vercel KV integration:
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Protects GET /api/brvm30/sync and GET /api/brvm30/sync-dividends-cron (Vercel Cron).
CRON_SECRET=""
